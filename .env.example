# ─────────────────────────────────────────────────────────────
# TailorAI environment. Copy to `.env` and adjust.
#
# IMPORTANT: every path below points at D:\ on purpose.
# C: has ~39 GB free; model weights + Docker volumes + MinIO
# data will exhaust it. Do not move these to C:.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Local data root (Docker volumes bind here) ──
DATA_ROOT=D:/tailorai/.data

# ── API ──
API_PORT=3000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081

# ── Postgres ──
POSTGRES_USER=tailorai
POSTGRES_PASSWORD=tailorai_dev_password
POSTGRES_DB=tailorai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tailorai:tailorai_dev_password@localhost:5432/tailorai?schema=public

# ── Redis (queue + SSE pub/sub) ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO in dev, Cloudflare R2 in prod) ──
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tailorai
S3_ACCESS_KEY_ID=tailorai
S3_SECRET_ACCESS_KEY=tailorai_dev_secret
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000

# Presigned URL lifetimes (seconds)
UPLOAD_URL_TTL=3600
DOWNLOAD_URL_TTL=300

# ── Auth ──
# AUTH_PROVIDER: "local" (dev, self-issued JWT) | "clerk" | "supabase"
AUTH_PROVIDER=local
JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# CLERK_SECRET_KEY=
# SUPABASE_JWT_SECRET=

# ── Reconstruction GPU service ──
# Dev: local Python service. Prod: RunPod/Modal endpoint.
RECONSTRUCTION_URL=http://localhost:8000
RECONSTRUCTION_TIMEOUT_MS=600000
RECONSTRUCTION_API_KEY=dev_internal_key

# ── Model tier & licensing gate (ADR-2) ──
# production => CI/build fails if any commercial_ok:false model is reachable
# research   => permits SMPL-derived models. NEVER use for real users.
MODEL_TIER=production
# ADAPTER: mock | sam3dbody | remote
RECONSTRUCTION_ADAPTER=mock
SEGMENTATION_ADAPTER=mock
WEIGHTS_DIR=D:/tailorai/.data/weights

# ── Pipeline tuning ──
MAX_VIDEO_DURATION_S=60
MAX_UPLOAD_BYTES=209715200
TARGET_FRAME_COUNT=16
FRAME_SAMPLE_FPS=4
TEXTURE_RESOLUTION=2048

# ── Retention (days) — legal requirement, see docs/06 ──
RAW_MEDIA_TTL_DAYS=30
INTERMEDIATE_TTL_DAYS=7
JOB_RECORD_TTL_DAYS=365

# ── Quotas & rate limits ──
MAX_CONCURRENT_JOBS_PER_USER=1
MAX_JOBS_PER_DAY_PER_USER=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ── Compliance ──
# Comma-separated ISO-3166-2 subdivisions to block (BIPA — see docs/06 §6.1)
BLOCKED_REGIONS=US-IL
MIN_AGE_YEARS=18
REQUIRE_BIOMETRIC_CONSENT=true

# ── Python GPU service ──
RECON_HOST=0.0.0.0
RECON_PORT=8000
RECON_DEVICE=cuda
RECON_MAX_VRAM_MB=7168
RECON_BATCH_SIZE=2
